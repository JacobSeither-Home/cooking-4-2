# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real values to the repo.
# In GitHub Actions these are set as Repository Secrets (Settings → Secrets).

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Your Apps → Web App → Config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Cloudflare Worker ─────────────────────────────────────────────────────────
# After deploying the worker (see README), paste the worker URL here.
# Example: https://cooking-4-2-worker.your-username.workers.dev
VITE_WORKER_URL=https://your-worker.workers.dev

# ── Google OAuth (for sign-in) ───────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
